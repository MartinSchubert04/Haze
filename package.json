{
  "name": "haze",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w @haze/desktop -- dev",
    "build": "npm run tauri -w @haze/desktop -- build",
    "check": "npm run check --workspaces --if-present",
    "tauri": "npm run tauri -w @haze/desktop --",
    "android": "npm run tauri -w @haze/mobile -- android dev",
    "android:apk": "npm run tauri -w @haze/mobile -- android build --debug --target aarch64 --apk"
  }
}
